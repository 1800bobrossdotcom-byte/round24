# Supabase — get these from Supabase → Project Settings → API
# Set these in Vercel (Settings → Environment Variables), NOT committed here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (optional) — the PUBLIC half of the VAPID pair from `node scripts/vapid-keys.mjs`.
# The private half is a Supabase secret (VAPID_KEYS_JSON). See docs/PUSH-SETUP.md.
VITE_VAPID_PUBLIC_KEY=
